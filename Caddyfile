# Caddy сам получает сертификат Let's Encrypt и продлевает его.
# Условие одно: домен из DOMAIN должен указывать A-записью на этот
# сервер, иначе проверку владения пройти не получится.
{$DOMAIN} {
	# Заголовки безопасности. API отдаёт только JSON и файлы, поэтому
	# набор минимальный, но нужный.
	header {
		# Браузеру: ходить сюда только по HTTPS ближайший год.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Не угадывать тип содержимого вопреки Content-Type.
		X-Content-Type-Options "nosniff"
		# Не показывать сайт внутри чужого фрейма.
		X-Frame-Options "DENY"
		# Не выдавать чужим сайтам, откуда к ним пришли.
		Referrer-Policy "no-referrer"
		# Версия сервера наружу не нужна.
		-Server
	}

	# Загрузка документов: подняли предел, иначе большие сканы
	# будут отваливаться ещё до того, как дойдут до приложения.
	request_body {
		max_size 100MB
	}

	reverse_proxy api:8000

	log {
		output file /data/access.log {
			roll_size 50MB
			roll_keep 10
		}
	}
}
