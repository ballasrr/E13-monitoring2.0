# Шаблон боевого .env. Скопировать на сервере в .env и заполнить.
# Сам .env в git не попадает — он в .gitignore, и так должно остаться.

# Домен, на котором будет работать API. A-запись должна указывать
# на этот сервер, иначе Caddy не получит сертификат.
DOMAIN=api.example.ru

# Адреса фронтенда через запятую. Звёздочка здесь запрещена кодом.
CORS_ORIGINS=https://example.ru

# База. Пароль сгенерировать, не придумывать:
#   openssl rand -base64 24
POSTGRES_DB=e13_monitoring
POSTGRES_USER=e13
POSTGRES_PASSWORD=СГЕНЕРИРОВАТЬ

# Ключ подписи токенов. Сменить его — разлогинить всех.
#   openssl rand -hex 48
SECRET_KEY=СГЕНЕРИРОВАТЬ

# Администратор создаётся при первом запуске и только если в базе
# никого нет. Пароль задать здесь СРАЗУ: эндпоинта смены пароля в
# проекте нет, и поменять его потом можно будет только через SQL.
FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_PASSWORD=СГЕНЕРИРОВАТЬ

# Предел размера загружаемого документа, мегабайт.
MAX_UPLOAD_MB=100

# Рабочих процессов uvicorn — обычно по числу ядер.
WORKERS=4
