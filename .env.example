# Скопируйте в .env и подставьте свои значения: copy .env.example .env

DEBUG=false

# ── Подключение к базе ──────────────────────────────────────────────────────
# db — имя сервиса Postgres в docker compose; localhost — запуск без контейнера
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=e13_monitoring
POSTGRES_USER=e13
POSTGRES_PASSWORD=смените-этот-пароль

DB_ECHO=false

# ── Сессии и безопасность ───────────────────────────────────────────────────
# Ключ подписи сессий. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=сгенерируйте-свой-ключ


# ── Первый администратор (создаётся, только если таблица пуста) ─────────────
FIRST_ADMIN_LOGIN=admin
FIRST_ADMIN_PASSWORD=admin12345
